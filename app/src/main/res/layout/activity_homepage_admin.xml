<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:background="#003B78"
            android:padding="10dp">

            <ImageView
                android:id="@+id/schoolLogo"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/mcs_logo"
                android:scaleType="fitCenter"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_toEndOf="@id/schoolLogo"
                android:layout_marginStart="15dp"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnHome"
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:text="HOME"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#003B78" />

                    <Button
                        android:id="@+id/btnHealth"
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:text="HEALTH RECORD"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#003B78" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSearch"
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:text="SEARCH"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#003B78" />

                    <Button
                        android:id="@+id/btnMedical"
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:text="MEDICAL RECORD"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#003B78" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_alignParentEnd="true">

                <Button
                    android:id="@+id/btnAbout"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="ABOUT"
                    android:textSize="9sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#003B78" />

                <Button
                    android:id="@+id/btnProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="PROFILE"
                    android:textSize="9sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#003B78" />

            </LinearLayout>
        </RelativeLayout>

        <!-- MAIN BACKGROUND -->
        <RelativeLayout
            android:layout_dr
            android:layout_width="match_parent"
            android:layout_height="650dp"
            android:background="@drawable/taeblue___instagram_story___1_">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="12dp">

                <!-- WELCOME -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome\nAdmin!"
                    android:textColor="#003B78"
                    android:textSize="43sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:lineSpacingExtra="-5dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="This application was made by MCS (Manila Cathedral School) for MCSians, for the sole purpose of viewing student's medical health record only."
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Get started!"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#001F40"
                    android:layout_marginTop="5dp" />

                <!-- SEARCH BUTTON -->
                <Button
                    android:id="@+id/btnMainSearch"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="Search"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#003B78"
                    android:backgroundTint="#E9DC4C"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="110dp" />

                <!-- HEALTH RECORD -->
                <Button
                    android:id="@+id/btnMainHealth"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="Health record"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#003B78"
                    android:backgroundTint="#E9DC4C"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="110dp" />

                <!-- MEDICAL RECORD -->
                <Button
                    android:id="@+id/btnMainMedical"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="Medical record"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#003B78"
                    android:backgroundTint="#E9DC4C"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="85dp" />

                <!-- PROFILE -->
                <Button
                    android:id="@+id/btnMainProfile"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="Profile"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#003B78"
                    android:backgroundTint="#E9DC4C"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="110dp" />

                <!-- WEBSITE -->
                <Button
                    android:id="@+id/btnWebsite"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:text="www.MCSMedical.com"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:backgroundTint="#003B78"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="55dp" />

                <!-- CONTACT -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Have any concern? contact us:\nmcstayuman1949@yahoo.com"
                    android:textColor="#001F40"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="15dp" />

                <!-- ADDRESS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Located at 287 Tayuman Street, Tondo, Manila, 1012"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>
