<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:visibility="visible"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:background="#003B78"
            android:padding="10dp">

            <ImageView
                android:id="@+id/schoolLogo"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:scaleType="fitCenter"
                android:src="@drawable/mcs_logo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="15dp"
                android:layout_toEndOf="@id/schoolLogo"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnHome"
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:backgroundTint="#003B78"
                        android:text="HOME"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btnHealth"
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:backgroundTint="#003B78"
                        android:text="HEALTH RECORD"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSearch"
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:backgroundTint="#003B78"
                        android:text="SEARCH"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btnMedical"
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:backgroundTint="#003B78"
                        android:text="MEDICAL RECORD"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnAbout"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:backgroundTint="#003B78"
                    android:text="ABOUT"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />

                <Button
                    android:id="@+id/btnProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:backgroundTint="#003B78"
                    android:text="PROFILE"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />

            </LinearLayout>
        </RelativeLayout>

        <!-- MAIN BACKGROUND -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="650dp"
            android:layout_dr
            android:background="@drawable/taeblue___instagram_story___1_">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- WELCOME -->


                <!-- SEARCH BUTTON -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="5dp"
                    android:text="Looking for something?"
                    android:textColor="#001F40"
                    android:textSize="32sp"
                    android:textStyle="italic|bold" />

                <Button
                    android:id="@+id/btnMainSearch"
                    android:layout_width="570dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="110dp"
                    android:backgroundTint="#FFFFFF"
                    android:text="Search"
                    android:textColor="#003B78"
                    android:textSize="20sp"
                    android:textStyle="bold"

                <!-- CONTACT -->

                <!-- ADDRESS -->

            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>
    3