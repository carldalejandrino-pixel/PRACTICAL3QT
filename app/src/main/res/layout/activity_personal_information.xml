<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/hello"
        android:scaleType="centerCrop"
        android:contentDescription="Background"/>

    <!-- Blue Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#7080DC"/>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="50dp"
            android:paddingBottom="30dp">

            <!-- Main Heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Care you can trust!"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"/>

            <!-- Sub Heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create an account"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:layout_marginTop="3dp"/>

            <!-- Signup Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#F5F6F8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <!-- School Logo -->
                    <ImageView
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:src="@drawable/mcs_logo"
                        android:scaleType="fitCenter"
                        android:contentDescription="School Logo"/>

                    <!-- Form Title -->
                    <TextView
                        android:layout_width="355dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:gravity="center"
                        android:text="Personal Information"
                        android:textColor="#009CFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!-- Name Label -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Your name"
                        android:textSize="11sp"
                        android:textColor="#333333"/>

                    <!-- First and Last Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="4dp">

                        <EditText
                            android:id="@+id/etFirstName"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input"
                            android:hint="First Name"
                            android:textSize="11sp"
                            android:textColorHint="#888888"
                            android:textColor="#222222"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:singleLine="true"
                            android:inputType="textPersonName"/>

                        <View
                            android:layout_width="8dp"
                            android:layout_height="1dp"/>

                        <EditText
                            android:id="@+id/etLastName"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input"
                            android:hint="Last Name"
                            android:textSize="11sp"
                            android:textColorHint="#888888"
                            android:textColor="#222222"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:singleLine="true"
                            android:inputType="textPersonName"/>

                    </LinearLayout>

                    <!-- Email Label -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Email Address"
                        android:textSize="11sp"
                        android:textColor="#333333"
                        android:layout_marginTop="14dp"/>

                    <!-- Email Address -->
                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:hint="26-0001234@mcstayuman.edu.ph"
                        android:textSize="11sp"
                        android:textColorHint="#888888"
                        android:textColor="#222222"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:inputType="textEmailAddress"
                        android:drawableEnd="@drawable/ic_email"
                        android:drawablePadding="5dp"/>

                    <!-- Username Label -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Username"
                        android:textSize="11sp"
                        android:textColor="#333333"
                        android:layout_marginTop="14dp"/>

                    <!-- Username -->
                    <EditText
                        android:id="@+id/etUsername"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:hint="example12345"
                        android:textSize="11sp"
                        android:textColorHint="#888888"
                        android:textColor="#222222"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:inputType="text"/>

                    <!-- Save and Continue -->
                    <Button
                        android:id="@+id/btnSaveContinue"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="28dp"
                        android:background="@drawable/bg_button_primary"
                        android:backgroundTint="@null"
                        android:text="Save and Continue"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"/>

                    <!-- Back to Login -->
                    <TextView
                        android:id="@+id/tvBackLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Back to log in"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:layout_marginTop="16dp"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <!-- Contact Information -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Have any concern? contact us!\nmcstayuman1949@yahoo.com"
                        android:textSize="9sp"
                        android:textColor="#555555"
                        android:gravity="center"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="4dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
